<Project>

  <!-- MSBuild stops at the nearest Directory.Build.props, so pull in the root one
       explicitly; without this the tests would lose net10.0, nullable and
       TreatWarningsAsErrors. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <!-- CA1707 bans underscores in member names. Test methods are named
         Subject_does_the_expected_thing by convention, which reads far better in
         test output, so the rule is off for tests only - never for src. -->
    <!-- CA1711 reserves the "Collection" suffix for ICollection implementations, but
         [CollectionDefinition] classes are named XyzCollection by xunit convention and
         keeping that convention is worth more here than a rule aimed at public API design. -->
    <NoWarn>$(NoWarn);CA1707;CA1711</NoWarn>
  </PropertyGroup>

  <!-- Shared by every test project, so the dependency-rule reader lives in one file
       instead of being copied into each. -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <Compile Include="$(MSBuildThisFileDirectory)DependencyRule.cs" Link="DependencyRule.cs" />
  </ItemGroup>

</Project>
