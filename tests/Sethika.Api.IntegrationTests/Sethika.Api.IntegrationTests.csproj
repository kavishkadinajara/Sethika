<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable and ImplicitUsings come from Directory.Build.props -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sethika.Api\Sethika.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seed for the Row-Level Security tests; read back out of the assembly at run time. -->
    <EmbeddedResource Include="Persistence\RlsTestData.sql" />
    <!-- The shipped catalogue seed itself, so its idempotency and its guards are tested on the real script. -->
    <EmbeddedResource Include="..\..\src\Sethika.Database\Scripts\Seed\10_RbacCatalogue.sql" Link="Persistence\10_RbacCatalogue.sql" />
    <!-- And the SMS template seed, for the same reason. -->
    <EmbeddedResource Include="..\..\src\Sethika.Database\Scripts\Seed\11_NotifyTemplates.sql" Link="Persistence\11_NotifyTemplates.sql" />
  </ItemGroup>

</Project>
