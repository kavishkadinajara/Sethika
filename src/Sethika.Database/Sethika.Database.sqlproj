<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.3.0" />
  <PropertyGroup>
    <Name>Sethika.Database</Name>
    <!-- SQL Server 2022 target for local dev. Publishing to Azure SQL: add /p:AllowIncompatiblePlatform=true
         or switch to Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <DefaultCollation>SQL_Latin1_General_CP1_CI_AS</DefaultCollation>
    <!-- Azure SQL runs with READ_COMMITTED_SNAPSHOT on; local databases match it, so a race that only
         shows when plain reads stop waiting for writers is found here, not in production. -->
    <ReadCommittedSnapshot>True</ReadCommittedSnapshot>
    <TreatTSqlWarningsAsErrors>false</TreatTSqlWarningsAsErrors>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <!-- Scripts are not schema objects: exclude them from the model, then register the post-deploy entry point -->
    <Build Remove="Scripts\**\*.sql" />
    <None Include="Scripts\Seed\*.sql" />
    <PostDeploy Include="Scripts\PostDeployment.sql" />
  </ItemGroup>
</Project>