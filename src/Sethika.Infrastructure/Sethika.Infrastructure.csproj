<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable and ImplicitUsings come from Directory.Build.props -->

  <ItemGroup>
    <ProjectReference Include="..\Sethika.Application\Sethika.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <!-- Background jobs (plan 02, B10): the outbox processor now, reminders and recurring bookings
         later. NetCore rather than AspNetCore because there is no dashboard (5.7). -->
    <PackageReference Include="Hangfire.NetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageReference Include="libphonenumber-csharp" Version="9.0.40" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
    <!-- Not used directly. Pins a transitive dependency of Microsoft.Data.SqlClient (6.1.7 still asks
         for 9.0.11) to the release that fixes CVE-2026-84008 and CVE-2026-70162 (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7, both .NET denial of service, published 2026-10-13). Remove it once
         SqlClient depends on a patched version: `dotnet nuget why` shows what it resolves to. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Not used directly. Hangfire.Core asks for Newtonsoft.Json 11.0.1 or later, which resolves to
         11.0.1 and its CVE-2024-21907 (GHSA-5crp-9r3c-p9vr, stack overflow on deeply nested input).
         13.0.1 fixed it. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
