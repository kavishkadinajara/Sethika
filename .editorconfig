root = true

[*]
indent_style = space
indent_size = 4
# LF, not CRLF. Nearly every file in the repo is already LF, CI runs on Linux, and
# .gitattributes normalises on checkin - so crlf here only produced dotnet format failures.
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,ts,tsx,js,jsx,css,md}]
indent_size = 2

# Visual Studio still writes solution files with CRLF and rewrites them if changed.
[*.sln]
end_of_line = crlf

[*.cs]
dotnet_style_qualification_for_field = false:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion

# Naming rules are matched in order, first match wins, so the specific modifier rules must
# come before the general private-field rule. Without them IDE1006 demands an underscore on
# PascalCase constants, which is not the C# convention.
dotnet_naming_rule.constants_pascal_case.symbols = constant_fields
dotnet_naming_rule.constants_pascal_case.style = pascal_case
dotnet_naming_rule.constants_pascal_case.severity = warning
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const

dotnet_naming_rule.static_readonly_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_pascal_case.severity = warning
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_rule.private_fields_underscore.symbols = private_instance_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.pascal_case.capitalization = pascal_case

# CA1711 reserves the "Permission" suffix for System.Security permission classes, which this
# codebase has none of. The RBAC entities are named for their tables (auth.Permissions,
# auth.RolePermissions, ...), and renaming them to dodge the rule would hide that mapping.
dotnet_code_quality.CA1711.allowed_suffixes = Permission
