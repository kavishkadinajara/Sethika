{
  // Sethika debug configurations.
  //
  // "Full stack" is the one to press F5 on: it starts the API and the Next.js dev server
  // together, since almost nothing in this app is testable with only one of them running.
  //
  // Ports come from src/Sethika.Api/Properties/launchSettings.json (http 5182, https 7186)
  // and Next.js (3000). Change them in one place - launchSettings - not here.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: api",
      "program": "${workspaceFolder}/src/Sethika.Api/bin/Debug/net10.0/Sethika.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Sethika.Api",
      "stopAtEntry": false,
      // Connection strings and the signing key come from User Secrets, so nothing
      // sensitive belongs in this file.
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development"
      },
      // No serverReadyAction here: "Web: Next.js server" opens the browser. Two launches
      // share js-debug's Chrome profile, and the second fails with "Unable to attach to browser".
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      // The API on every interface, so a phone on the same Wi-Fi can reach it. No browser.
      "name": "API (phone on Wi-Fi)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: api",
      "program": "${workspaceFolder}/src/Sethika.Api/bin/Debug/net10.0/Sethika.Api.dll",
      // Command-line --urls wins over launchSettings' applicationUrl.
      "args": ["--urls", "http://0.0.0.0:5182"],
      "cwd": "${workspaceFolder}/src/Sethika.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      // Metro for Expo Go. The QR code and the a/r/j keys are in the terminal it opens.
      "name": "Mobile: Expo",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "mobile: point at this computer",
      "cwd": "${workspaceFolder}/mobile",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--lan"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "API (attach)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Web: Next.js server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**"],
      // Opens "Web: Chrome" once Next.js is actually listening, so the browser gets the
      // sourceMapPathOverrides defined there.
      "serverReadyAction": {
        "action": "startDebugging",
        "pattern": "- Local:\\s+(https?://\\S+)",
        "name": "Web: Chrome"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Web: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/web",
      // Next.js serves client bundles from these virtual roots; without the mapping
      // breakpoints in .tsx files bind to the wrong file or not at all.
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/web/*",
        "webpack://*": "${workspaceFolder}/web/*",
        "turbopack://[project]/*": "${workspaceFolder}/web/*"
      }
    },
    {
      "name": "Tests: all",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: solution",
      "program": "dotnet",
      "args": ["test", "${workspaceFolder}/Sethika.sln", "--no-build"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ],
  "compounds": [
    {
      "name": "Full stack (API + Web)",
      "configurations": ["API", "Web: Next.js server"],
      "preLaunchTask": "build: solution",
      "stopAll": true,
      "presentation": {
        "group": "00-fullstack",
        "order": 1
      }
    },
    {
      "name": "Mobile on phone (API + Expo)",
      "configurations": ["API (phone on Wi-Fi)", "Mobile: Expo"],
      "stopAll": true,
      "presentation": {
        "group": "00-fullstack",
        "order": 2
      }
    }
  ]
}
